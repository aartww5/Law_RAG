    </mxCell>
    <mxCell id="generator" value="SimpleGenerator (llm.py)&#xa;[提示词工程 / 兜底策略]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="generation_layer">
      <mxGeometry x="300" y="60" width="200" height="60" as="geometry" />
    </mxCell>
    <mxCell id="ollama" value="Ollama (LLM Engine)&#xa;[Qwen35-Law / DeepSeek-R1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="generation_layer">
      <mxGeometry x="550" y="60" width="220" height="60" as="geometry" />
    </mxCell>

    <!-- Cross-layer arrows -->
    <mxCell id="e1" value="发送消息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chainlit" target="legal_service">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e2" value="调度检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="legal_service" target="exact_retriever">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e3" value="返回候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="hybrid_retriever" target="context_builder">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e4" value="流式推理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="generation_layer" source="generator" target="ollama">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e5" value="返回生成结果 (流式)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="ollama" target="chainlit">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="930" y="630" />
          <mxPoint x="930" y="130" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Data Annotation -->
    <mxCell id="data_anno" value="数据支撑:&#xa;• Qdrant (Vector DB)&#xa;• BM25 Cache&#xa;• MiniRAG Index&#xa;• 法律语料库 (JSONL)" style="text;html=1;strokeColor=#c0c0c0;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacing=5" vertex="1" parent="1">
