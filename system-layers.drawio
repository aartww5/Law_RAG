<mxGraphModel>
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Title -->
    <mxCell id="title" value="统一法律 RAG 系统分层架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="350" y="20" width="300" height="30" as="geometry" />
    </mxCell>

    <!-- UI Layer -->
    <mxCell id="ui_layer" value="前端交互层 (UI Layer)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="100" y="80" width="800" height="100" as="geometry" />
    </mxCell>
    <mxCell id="chainlit" value="Chainlit (app.py)&#xa;[会话管理 / 流式渲染 / &lt;think&gt; 块解析]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="ui_layer">
      <mxGeometry x="250" y="40" width="300" height="50" as="geometry" />
    </mxCell>

    <!-- Service Orchestration Layer -->
    <mxCell id="service_layer" value="服务编排层 (Service Orchestration Layer)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="100" y="200" width="800" height="150" as="geometry" />
    </mxCell>
    <mxCell id="legal_service" value="LegalAssistantService (services.py)&#xa;[RAG 全流程调度]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="service_layer">
      <mxGeometry x="50" y="60" width="220" height="60" as="geometry" />
    </mxCell>
    <mxCell id="rewriter" value="QueryRewriter (rewrite.py)&#xa;[对话改写]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="service_layer">
      <mxGeometry x="300" y="60" width="200" height="60" as="geometry" />
    </mxCell>
    <mxCell id="router" value="AutoRouter (router/auto.py)&#xa;[动态路由决策]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="service_layer">
      <mxGeometry x="540" y="60" width="210" height="60" as="geometry" />
    </mxCell>

    <!-- Retrieval Layer -->
    <mxCell id="retrieval_layer" value="检索层 (Retrieval Layer)" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="100" y="370" width="800" height="150" as="geometry" />
    </mxCell>
    <mxCell id="exact_retriever" value="ExactMatchRetriever&#xa;(exact_match.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="retrieval_layer">
      <mxGeometry x="50" y="60" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="hybrid_retriever" value="HybridRetriever (hybrid.py)&#xa;[Qdrant + BM25 + RRF]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="retrieval_layer">
      <mxGeometry x="270" y="60" width="260" height="60" as="geometry" />
    </mxCell>
    <mxCell id="mini_retriever" value="MiniRetriever (mini.py)&#xa;[MiniRAG 图检索]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="retrieval_layer">
      <mxGeometry x="570" y="60" width="180" height="60" as="geometry" />
    </mxCell>

    <!-- Generation Layer -->
    <mxCell id="generation_layer" value="生成层 (Generation Layer)" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="100" y="540" width="800" height="150" as="geometry" />
    </mxCell>
    <mxCell id="context_builder" value="ContextBuilder&#xa;(context_builder.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="generation_layer">
