<mxGraphModel>
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- System Boundary -->
    <mxCell id="sys_boundary" value="统一法律 RAG 系统" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="80" width="400" height="520" as="geometry" />
    </mxCell>

    <!-- Use Cases -->
    <mxCell id="uc1" value="发起法律咨询提问" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sys_boundary">
      <mxGeometry x="110" y="50" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="uc2" value="获取结构化法律回复" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sys_boundary">
      <mxGeometry x="110" y="130" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="uc3" value="查看法律条文原文/引用" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="sys_boundary">
      <mxGeometry x="110" y="210" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="uc4" value="进行多轮追问/上下文对话" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sys_boundary">
      <mxGeometry x="110" y="290" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="uc5" value="查看 AI 推理思考过程&#xa;(Chain of Thought)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sys_boundary">
      <mxGeometry x="110" y="370" width="180" height="60" as="geometry" />
    </mxCell>
    <mxCell id="uc6" value="精确检索特定法条内容" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="sys_boundary">
      <mxGeometry x="110" y="450" width="180" height="50" as="geometry" />
    </mxCell>

    <!-- Actors -->
    <mxCell id="public" value="普通公众" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
      <mxGeometry x="100" y="180" width="30" height="60" as="geometry" />
    </mxCell>
    <mxCell id="learner" value="学习者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
      <mxGeometry x="100" y="380" width="30" height="60" as="geometry" />
    </mxCell>
    
    <!-- LLM Supporting System -->
    <mxCell id="llm_system" value="&lt;&lt;System&gt;&gt;&#xa;LLM / Ollama" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="720" y="260" width="100" height="80" as="geometry" />
    </mxCell>

    <!-- Associations: Public -->
    <mxCell id="a1" edge="1" parent="1" source="public" target="uc1" style="endArrow=none;html=1;rounded=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a2" edge="1" parent="1" source="public" target="uc2" style="endArrow=none;html=1;rounded=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a3" edge="1" parent="1" source="public" target="uc3" style="endArrow=none;html=1;rounded=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a4" edge="1" parent="1" source="public" target="uc4" style="endArrow=none;html=1;rounded=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Associations: Learner -->
    <mxCell id="a5" edge="1" parent="1" source="learner" target="uc3" style="endArrow=none;html=1;rounded=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a6" edge="1" parent="1" source="learner" target="uc5" style="endArrow=none;html=1;rounded=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a7" edge="1" parent="1" source="learner" target="uc6" style="endArrow=none;html=1;rounded=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- System Associations -->
    <mxCell id="a9" value="支撑回答生成" style="endArrow=block;dashed=1;html=1;rounded=0;exitX=0;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="llm_system" target="uc2">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="a10" value="支撑思考链展示" style="endArrow=block;dashed=1;html=1;rounded=0;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="llm_system" target="uc5">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Annotations -->
    <mxCell id="note" value="角色说明:&#xa;- 普通公众: 侧重于获得直观、通俗的法律解答。&#xa;- 学习者: 侧重于核实法条原文及查看 AI 的推理逻辑。" style="text;html=1;strokeColor=#c0c0c0;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacing=5" vertex="1" parent="1">
      <mxGeometry x="50" y="550" width="180" height="70" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
